# Cấu hình biến môi trường mẫu (KHÔNG điền khóa thật vào tệp mẫu này)
# Sao chép thành `.env` khi chạy cục bộ hoặc cài đặt trong Hugging Face Space Secrets.

# Cổng web FastAPI (mặc định trên HF Spaces là 7860)
PORT=7860

# Bật chế độ phi trạng thái trong Container (không ghi khóa API ra đĩa)
CLOUD_STATELESS_ENV=1

# Mật khẩu quản trị tài khoản `admin` và khóa ký phiên phi trạng thái HMAC-SHA256
APP_ADMIN_PASSWORD=thay_doi_mat_khau_manh_tai_day
APP_SECRET_KEY=thay_doi_chuoi_bi_mat_ngau_nhien_tai_day

# Tầng Lưu trữ Bền vững Đám mây (chọn 1 trong 2)
# 1) Hugging Face Hub Private Dataset Storage (khuyên dùng trên Public Cloud):
# HF_STORAGE_REPO=username/tra-cuu-luu-tru-so-storage
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxx
# 2) Persistent Volume cục bộ / Docker Compose:
# CLOUD_VOLUME_DIR=./cloud_volume

# Tầng Mô hình Ngôn ngữ Đám mây (OpenRouter API)
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxx
