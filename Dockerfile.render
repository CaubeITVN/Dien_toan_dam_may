FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/.cache/huggingface \
    CLOUD_STATELESS_ENV=1 \
    ASYNC_STARTUP=1 \
    OCR_RENDER_DPI=180 \
    OMP_THREAD_LIMIT=1 \
    MALLOC_ARENA_MAX=2 \
    DENSE=0 \
    LLM_PROVIDER=openrouter \
    OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free \
    PORT=10000

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-vie \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 user

WORKDIR /app

COPY requirements-render.txt .
RUN pip install --no-cache-dir -r requirements-render.txt

RUN mkdir -p /app/.cache/huggingface /app/data/uploads /app/data/processed /app/data/raw /app/data/ocr /app/models/dense /app/cloud_volume

COPY . .

RUN chown -R user:user /app

USER user

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD python -c "import os, urllib.request; p = os.environ.get('PORT', '10000'); urllib.request.urlopen(f'http://127.0.0.1:{p}/healthz', timeout=4)"

CMD ["sh", "-c", "uvicorn web.app:app --host 0.0.0.0 --port ${PORT:-10000}"]
